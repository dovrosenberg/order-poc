{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "phase1.ts", "*.test.ts", "src/**/*.test.ts", "src/phase1-types.ts", "src/lib/*.ts", "src/env.d.ts"]
}
